# ─── Railway / Render / Fly.io deployment ─────────────────────────
# These platforms auto-detect Node.js. Just set the env vars below.

# Database (from your cloud provider)
DATABASE_URL=postgresql://...
DATABASE_SSL=true

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-random-64-byte-hex
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Encryption — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-char-hex-key

# Storage (S3-compatible cloud storage)
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=orgvault-data
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
SYNC_ENABLED=true
SYNC_INTERVAL_SECONDS=300

# Server
PORT=4000
NODE_ENV=production
CORS_ORIGIN=https://your-frontend.vercel.app,https://your-frontend.netlify.app

# Audit
AUDIT_LOG_ENABLED=true
