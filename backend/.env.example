# OrgVault Backend

# ─── Database ──────────────────────────────────────────────────────────
# For cloud-hosted databases (Neon, Railway, Render, Supabase, RDS), paste
# the connection string from your provider and set DATABASE_SSL=true.
# Examples:
#   Neon:    postgresql://user:pass@ep-xxxx.us-east-2.aws.neon.tech/db?sslmode=require
#   Railway: postgresql://postgres:pass@containers-us-west-xx.railway.app:port/railway
#   Render:  postgresql://user:pass@dpg-xxxx.oregon-postgres.render.com/db
#   Supabase: postgresql://postgres.xxxx:pass@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://orgvault:orgvault@localhost:5432/orgvault
DATABASE_SSL=false

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Encryption
ENCRYPTION_KEY=change-me-to-a-64-char-hex-string-00000000000000000000000000000000

# Storage - Local
LOCAL_STORAGE_PATH=./storage

# Storage - Cloud (S3-compatible)
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=orgvault-data
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key

# Sync
SYNC_INTERVAL_SECONDS=300
SYNC_ENABLED=false

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Audit
AUDIT_LOG_ENABLED=true
